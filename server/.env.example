DATABASE_URL=postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
PORT=3000

# Demo mode: enables /demo routes and the legacy time-window signal (for hardware-free demos and the current firmware).
# DEMO_MODE=true

# --- WAT2DO event import (see the README) ---
# Secret for POST /admin/import-wat2do, sent as "Authorization: Bearer <secret>". Generate one with:
#   openssl rand -hex 32
# Unset, shorter than 16 characters, or left as this placeholder = the endpoint stays locked for everyone.
ADMIN_IMPORT_SECRET=replace-with-a-long-random-secret
# Scheduled imports are OFF unless this is exactly "true".
ENABLE_WAT2DO_IMPORT=false
WAT2DO_IMPORT_CRON=0 * * * *
WAT2DO_BASE_URL=https://wat2do.ca
